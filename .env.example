# Uni-Steps 環境変数設定ガイド
# -----------------------------------------------------------------------------
# Uni-Steps は GO_ENV 環境変数に応じて読み込むファイルを切り替えます．
# - GO_ENV="production"  => .env.production を読み込み
# - GO_ENV="development" => .env.development を読み込み
# - 指定なし            => .env を読み込み
# -----------------------------------------------------------------------------

# 1．データベース設定 (Supabase / PostgreSQL)
DATABASE_URL="postgres://postgres.[YOUR_ID]:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres"

# 2．生成 AI 設定 (Google AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="models/gemini-1.5-flash"

# 3．Google OAuth 2.0 設定 (Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# ※ 開発時は http://localhost:8080/api/auth/google/callback
# ※ 本番時は https://[あなたのRender名].onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URL="http://localhost:8080/api/auth/google/callback"

# 4．Web Push 通知設定 (VAPID)
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_CONTACT="mailto:your-email@example.com"

# 5．LINE 通知設定 (LINE Developers / 任意)
LINE_CHANNEL_TOKEN="YOUR_LINE_CHANNEL_TOKEN"

# 6．連携・ポート設定
# ※ 開発時は http://localhost:5173
# ※ 本番時は https://[あなたのVercel名].vercel.app
FRONTEND_URL="http://localhost:5173"
PORT="8080"

# Uni-Steps 環境変数設定テンプレート
# 実際に使用する際は，このファイルを .env にコピーし，各値を適切に設定すること．

# 1．データベース設定 (Supabase / PostgreSQL)
# Supabase の Project Settings > Database > Connection string > URI から取得する．
DATABASE_URL="postgres://postgres.[YOUR_ID]:[YOUR_PASSWORD]@[YOUR_HOST]:5432/postgres"

# 2．生成 AI 設定 (Google AI Studio)
# https://aistudio.google.com/ で発行した API キーを設定する．
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# 使用するモデル名を設定する（省略時は gemini-1.5-flash）．
# 候補: gemini-1.5-flash (安定), gemini-2.0-flash (最新・高速)
GEMINI_MODEL="models/gemini-2.0-flash-lite"

# 3．LINE 通知設定 (LINE Developers)
# Messaging API チャネルの Channel access token (long-lived) を設定する．
LINE_CHANNEL_TOKEN="YOUR_LINE_CHANNEL_TOKEN"

# 4．Google OAuth 2.0 設定 (Google Cloud Console)
# Google Classroom 連携に使用するクライアント ID とシークレットを設定する．
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URL="http://localhost:8080/api/auth/google/callback"

# 5．Web Push 通知設定 (VAPID)
# `go run cmd/vapid/main.go` を実行して生成されたキーを設定する．
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
# 送信者の連絡先（mailto:メールアドレス）を設定する．
VAPID_CONTACT="mailto:your-email@example.com"

# 6．サーバー設定
PORT="8080"
# フロントエンドの URL（末尾のスラッシュなし）．
# 開発時: http://localhost:5173
# 本番時: https://uni-steps.vercel.app
FRONTEND_URL="http://localhost:5173"
